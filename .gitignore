__pycache__/
*.pyc
logs/
models/
data/
# ...but scripts/data/ and slurm/data/ hold CODE (the 3DPW -> Anny converter and its job scripts); the other
# rules (*.npz, *.pkl, __pycache__/, ...) still apply inside them.
!scripts/data/
!slurm/data/
# datasets/ holds the dataloader CODE (annyone.py, bedlam.py, threedpw.py,
# threedpw_anny.py, ...) which train.py imports - track the .py files, ignore data.
datasets/*
!datasets/*.py
demo_out*/
*.npz
*.npy
*.pkl
*.pt
*.pt.*
*.pth
*.ckpt
*.glb
*.bak*
* - Copy*
*copy*
*_old.py
*_orignal.py

# 3DPW -> Anny conversion outputs (fits, renders). Only the label index files are tracked.
threedpw_anny/
threedpw_anny_v21/
annyone_3dpw/
threedpw_anny_full/*
!threedpw_anny_full/labels/

# generated reports
shape_report.txt

# Local video overlays and per-frame prediction dumps.
results/video_compare/
results/video_landmarks/

# experiment outputs: keep only the summaries (*.json) and notes (*.md); logs, images, checkpoints, npz stay local
results/experiments/**
!results/experiments/**/
!results/experiments/**/*.json
!results/experiments/**/*.md

# thesis plot data (small CSVs) is tracked although dataset folders named data/ are not
!docs/thesis/data/
